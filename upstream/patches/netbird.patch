+package quic
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	relayTLS "github.com/netbirdio/netbird/shared/relay/tls"
+	"github.com/quic-go/quic-go"
+)
+
+func TestNetGoQUICCustomCAAndHostname(t *testing.T) {
+	certificate := httptest.NewTLSServer(nil)
+	defer certificate.Close()
+	listener, err := quic.ListenAddr("127.0.0.1:0", &tls.Config{Certificates: certificate.TLS.Certificates, NextProtos: []string{relayTLS.NBalpn}}, &quic.Config{EnableDatagrams: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() {
+		for {
+			if _, err := listener.Accept(ctx); err != nil {
+				return
+			}
+		}
+	}()
+	address := "rels://" + listener.Addr().String()
+	dial := func(ctx context.Context, name string) error {
+		ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+		defer cancel()
+		conn, err := (Dialer{}).Dial(ctx, address, name)
+		if conn != nil {
+			_ = conn.Close()
+		}
+		return err
+	}
+	if err := dial(ctx, ""); err == nil {
+		t.Fatal("unknown private CA accepted")
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(certificate.Certificate())
+	trusted := relayTLS.WithNetGoRootCAs(ctx, pool)
+	if err := dial(trusted, ""); err != nil {
+		t.Fatal("explicit profile CA rejected", err)
+	}
+	if err := dial(trusted, "wrong.example.test"); err == nil {
+		t.Fatal("custom CA bypassed hostname verification")
+	}
+	if err := dial(relayTLS.WithNetGoRootCAs(trusted, nil), ""); err == nil {
+		t.Fatal("next profile inherited the old CA")
+	}
+}
