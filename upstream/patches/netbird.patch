index 0000000..ba6da43
--- /dev/null
+++ b/client/cmd/netgo_rpc.go
@@ -0,0 +1,229 @@
+package cmd
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/netbirdio/netbird/client/internal/profilemanager"
+	"github.com/netbirdio/netbird/client/proto"
+	"github.com/spf13/cobra"
+	"google.golang.org/grpc/metadata"
+)
+
+// This process adapter keeps daemon protobuf and caller authorization in NetBird.
+// Secrets travel on inherited stdin, never in command-line flags or log messages.
+var netgoRPCCmd = &cobra.Command{
+	Use: "netgo-rpc", Hidden: true, Args: cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		var req netgoRPCRequest
+		decoder := json.NewDecoder(io.LimitReader(cmd.InOrStdin(), 65537))
+		decoder.DisallowUnknownFields()
+		if err := decoder.Decode(&req); err != nil {
+			return json.NewEncoder(cmd.OutOrStdout()).Encode(map[string]string{"error": "engine_invalid_request"})
+		}
+		var tail any
+		if decoder.Decode(&tail) != io.EOF {
+			return json.NewEncoder(cmd.OutOrStdout()).Encode(map[string]string{"error": "engine_invalid_request"})
+		}
+		result, err := netgoRPC(cmd.Context(), req)
+		if err != nil {
+			result = map[string]string{"error": "engine_rpc_failed"}
+		}
+		return json.NewEncoder(cmd.OutOrStdout()).Encode(result)
+	},
+}
+
+func init() { rootCmd.AddCommand(netgoRPCCmd) }
+
+type netgoRPCProfile struct {
+	Protocol                                                                   int
+	ID, Name, Origin, CA, GatewayPeerID, GatewayIP, LocalRelay, AuxiliaryRelay string
+	Candidates                                                                 []struct{ ID, Address, Kind string }
+}
+type netgoRPCRequest struct {
+	Action    string          `json:"action"`
+	Profile   netgoRPCProfile `json:"profile"`
+	IDToken   string          `json:"id_token"`
+	Resources []struct {
+		CIDR               string `json:"cidr"`
+		ID, Name, Protocol string
+		Ports              []uint16
+		Enabled            bool
+	} `json:"resources"`
+}
+
+func netgoRPC(ctx context.Context, req netgoRPCRequest) (any, error) {
+	ctx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	conn, err := DialClientGRPCServer(ctx, daemonAddr)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	client := proto.NewDaemonServiceClient(conn)
+	user, err := profilemanager.InvokingUser()
+	if err != nil {
+		return nil, err
+	}
+	if req.Action == "down" {
+		_, err = client.Down(ctx, &proto.DownRequest{})
+		return map[string]bool{"done": err == nil}, err
+	}
+	p := req.Profile
+	if p.Protocol != 1 || !regexp.MustCompile("^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$").MatchString(p.ID) {
+		return nil, errors.New("invalid profile")
+	}
+	authority, err := url.Parse(p.Origin)
+	if err != nil || authority.Scheme != "https" || authority.Host == "" || authority.User != nil {
+		return nil, errors.New("invalid origin")
+	}
+	name := "netgo-" + p.ID
+	login := func(mode string) (*proto.LoginResponse, error) {
+		md := metadata.Pairs("netgo-mode", mode)
+		for _, c := range p.Candidates {
+			md.Append("netgo-candidate", c.Address)
+		}
+		if p.CA != "" {
+			md.Append("netgo-ca-bin", p.CA)
+		}
+		if mode == "native" {
+			md.Append("netgo-jwt", req.IDToken)
+		}
+		yes, no := true, false
+		return client.Login(metadata.NewOutgoingContext(ctx, md), &proto.LoginRequest{
+			ManagementUrl: p.Origin, ProfileName: &name, Username: &user.Username, DisableAutoConnect: &yes,
+			ServerSSHAllowed: &no, DisableServerRoutes: &yes, DisableIpv6: &yes, BlockInbound: &yes,
+		})
+	}
+	switch req.Action {
+	case "prepare":
+		if _, err = client.Down(ctx, &proto.DownRequest{}); err != nil {
+			return nil, err
+		}
+		profiles, err := client.ListProfiles(ctx, &proto.ListProfilesRequest{Username: user.Username})
+		if err != nil {
+			return nil, err
+		}
+		found := false
+		for _, profile := range profiles.Profiles {
+			if profile.Name == name {
+				if found {
+					return nil, errors.New("ambiguous profile")
+				}
+				found = true
+			}
+		}
+		if !found {
+			if _, err = client.AddProfile(ctx, &proto.AddProfileRequest{Username: user.Username, ProfileName: name}); err != nil {
+				return nil, err
+			}
+		}
+		response, err := login("prepare")
+		if err != nil {
+			return nil, err
+		}
+		if response.UserCode == "" || response.NeedsSSOLogin {
+			return nil, errors.New("native patch required")
+		}
+		return map[string]string{"wireguard_key": response.UserCode}, nil
+	case "login":
+		if req.IDToken == "" {
+			return nil, errors.New("token required")
+		}
+		_, err = login("native")
+		return map[string]bool{"done": err == nil}, err
+	case "up":
+		_, err = client.Up(ctx, &proto.UpRequest{ProfileName: &name, Username: &user.Username, Async: true})
+		return map[string]bool{"done": err == nil}, err
+	case "remove":
+		profiles, err := client.ListProfiles(ctx, &proto.ListProfilesRequest{Username: user.Username})
+		if err != nil {
+			return nil, err
+		}
+		found := false
+		for _, profile := range profiles.Profiles {
+			if profile.Name == name {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return map[string]bool{"done": true}, nil
+		}
+		_, err = client.RemoveProfile(ctx, &proto.RemoveProfileRequest{Username: user.Username, ProfileName: name})
+		return map[string]bool{"done": err == nil}, err
+	case "status":
+		v, err := client.Status(ctx, &proto.StatusRequest{GetFullPeerStatus: true})
+		if err != nil {
+			return nil, err
+		}
+		out := map[string]any{"state": v.Status, "path": "negotiating", "ip": "", "relay": "", "rx": int64(0), "tx": int64(0)}
+		if v.FullStatus != nil {
+			if v.FullStatus.LocalPeerState != nil {
+				out["ip"] = v.FullStatus.LocalPeerState.IP
+			}
+			for _, peer := range v.FullStatus.Peers {
+				if strings.Split(peer.IP, "/")[0] != p.GatewayIP {
+					continue
+				}
+				out["rx"], out["tx"] = peer.BytesRx, peer.BytesTx
+				if !strings.EqualFold(peer.ConnStatus, "connected") {
+					continue
+				}
+				out["path"] = "direct"
+				if peer.Relayed {
+					out["relay"], out["path"] = peer.RelayAddress, "relay_unknown"
+					if p.LocalRelay != "" && strings.Contains(peer.RelayAddress, p.LocalRelay) {
+						out["path"] = "local_relay"
+					} else if p.AuxiliaryRelay != "" && strings.Contains(peer.RelayAddress, p.AuxiliaryRelay) {
+						out["path"] = "auxiliary_relay"
+					}
+				}
+				break
+			}
+		}
+		return out, nil
+	case "routes":
+		if len(req.Resources) == 0 {
+			return nil, errors.New("no authorized routes")
+		}
+		var ids []string
+		deadline := time.Now().Add(15 * time.Second)
+		for {
+			networks, err := client.ListNetworks(ctx, &proto.ListNetworksRequest{})
+			if err != nil {
+				return nil, err
+			}
+			ids = nil
+			for _, r := range req.Resources {
+				for _, n := range networks.Routes {
+					if n.Range == r.CIDR {
+						ids = append(ids, n.ID)
+						break
+					}
+				}
+			}
+			if len(ids) == len(req.Resources) {
+				break
+			}
+			if time.Now().After(deadline) {
+				return nil, errors.New("authorized route unavailable")
+			}
+			select {
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			case <-time.After(200 * time.Millisecond):
+			}
+		}
+		_, err = client.SelectNetworks(ctx, &proto.SelectNetworksRequest{NetworkIDs: ids, Append: false})
+		return map[string]bool{"done": err == nil}, err
+	default:
+		return nil, errors.New("unsupported action")
+	}
+}
