+		if !listener.Addr().(*net.TCPAddr).IP.IsLoopback() {
+			t.Fatal("explicit loopback bind became public", listener.Addr())
+		}
+		if err := listener.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if (&BaseServer{mgmtPort: 18080}).managementAddress() != ":18080" {
+		t.Fatal("legacy default changed")
+	}
+}
