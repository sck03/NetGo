diff --git a/shared/relay/client/netgo_selection.go b/shared/relay/client/netgo_selection.go
new file mode 100644
index 0000000..b06175e
--- /dev/null
+++ b/shared/relay/client/netgo_selection.go
@@ -0,0 +1,100 @@
+package client
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+)
+
+const netGoRoutingPeerEnv = "NB_NETGO_ROUTING_PEER"
+
+type netGoRelayRole uint8
+
+const (
+	netGoUnmanaged netGoRelayRole = iota
+	netGoClient
+	netGoRoutingPeer
+	netGoInvalidRole
+)
+
+type NetGoTopology struct {
+	Gateway    netip.Addr
+	LocalRelay string
+}
+type netGoClientKey struct{}
+type netGoTopologyKey struct{}
+
+// WithNetGoClient snapshots whether this context uses the NetGo profile adapter.
+func WithNetGoClient(ctx context.Context, active bool, topology NetGoTopology) context.Context {
+	ctx = context.WithValue(ctx, netGoTopologyKey{}, topology)
+	return context.WithValue(ctx, netGoClientKey{}, active)
+}
+
+func netGoRole(ctx context.Context) netGoRelayRole {
+	if value := os.Getenv(netGoRoutingPeerEnv); value != "" {
+		router, err := strconv.ParseBool(value)
+		if err != nil {
+			return netGoInvalidRole
+		}
+		if router {
+			return netGoRoutingPeer
+		}
+	}
+	if active, _ := ctx.Value(netGoClientKey{}).(bool); active {
+		return netGoClient
+	}
+	return netGoUnmanaged
+}
+
+// NetGoRelaySelection reports whether the manager uses the NetGo gateway topology.
+func (m *Manager) NetGoRelaySelection() bool {
+	return m.netgoRole != netGoUnmanaged
+}
+
+// Gateway links follow the client's reachable home relay. Between clients,
+// prefer the non-local home when one side needs it; otherwise use controller
+// ordering. Both peers therefore select the same Management-published endpoint.
+func (m *Manager) PreferredRelay(local, remote string, controller bool, remoteIP netip.Addr) (string, error) {
+	selected := remote
+	switch m.netgoRole {
+	case netGoUnmanaged:
+		if controller {
+			selected = local
+		}
+		return selected, nil
+	case netGoClient:
+		topology, _ := m.ctx.Value(netGoTopologyKey{}).(NetGoTopology)
+		if !topology.Gateway.IsValid() {
+			return "", errors.New("missing NetGo relay topology")
+		}
+		isLocal := func(endpoint string) bool {
+			parsed, err := url.Parse(endpoint)
+			return err == nil && topology.LocalRelay != "" && strings.EqualFold(parsed.Hostname(), topology.LocalRelay)
+		}
+		switch {
+		case remoteIP == topology.Gateway:
+			selected = local
+		case isLocal(local) && !isLocal(remote):
+			selected = remote
+		case isLocal(remote) && !isLocal(local):
+			selected = local
+		case controller:
+			selected = local
+		}
+	case netGoRoutingPeer:
+	default:
+		return "", errors.New("invalid NetGo relay role")
+	}
+	// Only Management-published endpoints are eligible. A peer cannot make the
+	// privileged gateway dial an arbitrary address or a different site's relay.
+	for _, allowed := range m.serverPicker.ServerURLs.Load().([]string) {
+		if allowed != "" && selected == allowed {
+			return selected, nil
+		}
+	}
+	return "", errors.New("NetGo relay endpoint is not published by Management")
+}
diff --git a/shared/relay/client/netgo_selection_test.go b/shared/relay/client/netgo_selection_test.go
new file mode 100644
index 0000000..18b8a7b
--- /dev/null
+++ b/shared/relay/client/netgo_selection_test.go
@@ -0,0 +1,95 @@
+package client
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+)
+
+func TestNetGoRelaySelectionBothControllerOrders(t *testing.T) {
+	t.Setenv(netGoRoutingPeerEnv, "false")
+	const local = "rels://192.0.2.1:18443"
+	const auxiliary = "rels://198.51.100.1:28443"
+	urls := []string{local, auxiliary}
+	client := NewManager(WithNetGoClient(context.Background(), true, NetGoTopology{Gateway: netip.MustParseAddr("100.96.0.1"), LocalRelay: "192.0.2.1"}), urls, "client", 1280)
+	t.Setenv(netGoRoutingPeerEnv, "true")
+	gateway := NewManager(context.Background(), urls, "gateway", 1280)
+	for _, controller := range []bool{false, true} {
+		for _, reachable := range urls {
+			clientChoice, err := client.PreferredRelay(reachable, local, controller, netip.MustParseAddr("100.96.0.1"))
+			if err != nil || clientChoice != reachable {
+				t.Fatalf("client home=%s controller=%t: %s %v", reachable, controller, clientChoice, err)
+			}
+			gatewayChoice, err := gateway.PreferredRelay(local, reachable, !controller, netip.MustParseAddr("100.96.0.1"))
+			if err != nil || gatewayChoice != clientChoice {
+				t.Fatalf("peers disagree for controller=%t: client=%s gateway=%s err=%v", controller, clientChoice, gatewayChoice, err)
+			}
+		}
+	}
+}
+
+func TestNetGoRelaySelectionNoVPSAndRemovedEndpoints(t *testing.T) {
+	t.Setenv(netGoRoutingPeerEnv, "true")
+	const local = "rels://192.0.2.1:18443"
+	manager := NewManager(context.Background(), []string{local}, "gateway", 1280)
+	selected, err := manager.PreferredRelay(local, local, false, netip.MustParseAddr("100.96.0.2"))
+	if err != nil || selected != local {
+		t.Fatalf("standalone local relay rejected: %s %v", selected, err)
+	}
+	for _, foreign := range []string{"", "rels://other-site:18443", "rel://192.0.2.1:18443", "rels://192.0.2.1:18444"} {
+		if _, err := manager.PreferredRelay(local, foreign, true, netip.MustParseAddr("100.96.0.2")); err == nil {
+			t.Fatalf("unpublished relay accepted: %q", foreign)
+		}
+	}
+	manager.serverPicker.ServerURLs.Store([]string{})
+	if _, err := manager.PreferredRelay(local, local, true, netip.MustParseAddr("100.96.0.2")); err == nil {
+		t.Fatal("removed relay remained selectable")
+	}
+}
+
+func TestNetGoRelaySelectionUnmanagedAndInvalidRole(t *testing.T) {
+	t.Setenv(netGoRoutingPeerEnv, "false")
+	manager := NewManager(context.Background(), []string{"local", "remote"}, "plain", 1280)
+	for _, controller := range []bool{false, true} {
+		want := "remote"
+		if controller {
+			want = "local"
+		}
+		got, err := manager.PreferredRelay("local", "remote", controller, netip.MustParseAddr("100.96.0.1"))
+		if err != nil || got != want || manager.NetGoRelaySelection() {
+			t.Fatalf("unmanaged selection changed: %s %v", got, err)
+		}
+	}
+	t.Setenv(netGoRoutingPeerEnv, "invalid")
+	manager = NewManager(context.Background(), []string{"local"}, "bad", 1280)
+	if _, err := manager.PreferredRelay("local", "local", true, netip.MustParseAddr("100.96.0.2")); err == nil {
+		t.Fatal("invalid role failed open")
+	}
+}
+
+func TestNetGoClientRelayAgreement(t *testing.T) {
+	t.Setenv(netGoRoutingPeerEnv, "false")
+	const local = "rels://192.0.2.1:18443"
+	const aux = "rels://198.51.100.1:28443"
+	ctx := WithNetGoClient(context.Background(), true, NetGoTopology{Gateway: netip.MustParseAddr("100.96.0.1"), LocalRelay: "192.0.2.1"})
+	a, b := NewManager(ctx, []string{local, aux}, "a", 1280), NewManager(ctx, []string{local, aux}, "b", 1280)
+	for _, controller := range []bool{true, false} {
+		for _, homes := range [][2]string{{local, aux}, {aux, local}, {local, local}, {aux, aux}} {
+			one, err := a.PreferredRelay(homes[0], homes[1], controller, netip.MustParseAddr("100.96.0.3"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			two, err := b.PreferredRelay(homes[1], homes[0], !controller, netip.MustParseAddr("100.96.0.2"))
+			want := local
+			if homes[0] == aux || homes[1] == aux {
+				want = aux
+			}
+			if err != nil || one != two || one != want {
+				t.Fatalf("homes=%v controller=%t: %s %s %v", homes, controller, one, two, err)
+			}
+		}
+	}
+	if _, err := a.PreferredRelay(local, "rels://foreign.test:443", true, netip.MustParseAddr("100.96.0.3")); err == nil {
+		t.Fatal("foreign relay accepted")
+	}
+}
diff --git a/shared/relay/tls/netgo.go b/shared/relay/tls/netgo.go
new file mode 100644
index 0000000..4f0425a
--- /dev/null
+++ b/shared/relay/tls/netgo.go
@@ -0,0 +1,25 @@
+package tls
+
+import (
+	"context"
+	"crypto/x509"
+)
+
+type netGoRootsKey struct{}
+
+// WithNetGoRootCAs carries a per-connection trust snapshot. A nil pool explicitly
+// restores system trust, including when a parent context held another profile.
+func WithNetGoRootCAs(ctx context.Context, roots *x509.CertPool) context.Context {
+	if roots != nil {
+		roots = roots.Clone()
+	}
+	return context.WithValue(ctx, netGoRootsKey{}, roots)
+}
+
+func NetGoRootCAs(ctx context.Context) *x509.CertPool {
+	roots, _ := ctx.Value(netGoRootsKey{}).(*x509.CertPool)
+	if roots == nil {
+		return nil
+	}
+	return roots.Clone()
+}
diff --git a/shared/relay/tls/netgo_test.go b/shared/relay/tls/netgo_test.go
new file mode 100644
index 0000000..2812518
--- /dev/null
+++ b/shared/relay/tls/netgo_test.go
@@ -0,0 +1,28 @@
+package tls
+
+import (
+	"context"
+	"crypto/x509"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestNetGoTrustSnapshotDoesNotLeakAcrossProfiles(t *testing.T) {
+	server := httptest.NewTLSServer(nil)
+	defer server.Close()
+	parent := context.Background()
+	pool := x509.NewCertPool()
+	ctx := WithNetGoRootCAs(parent, pool)
+	pool.AddCert(server.Certificate())
+	if NetGoRootCAs(parent) != nil || len(NetGoRootCAs(ctx).Subjects()) != 0 {
+		t.Fatal("mutable trust escaped its connection context")
+	}
+	returned := NetGoRootCAs(ctx)
+	returned.AddCert(server.Certificate())
+	if len(NetGoRootCAs(ctx).Subjects()) != 0 {
+		t.Fatal("dialer modified shared trust")
+	}
+	if NetGoRootCAs(WithNetGoRootCAs(ctx, nil)) != nil {
+		t.Fatal("next profile inherited custom trust")
+	}
+}
