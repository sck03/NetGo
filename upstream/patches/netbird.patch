@@ -0,0 +1,31 @@
+package cmd
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+func TestNetGoRPCFramedRequests(t *testing.T) {
+	command := &cobra.Command{}
+	command.SetIn(strings.NewReader("{invalid}\n{\"unknown\":true}\n"))
+	var output bytes.Buffer
+	command.SetOut(&output)
+	if err := netgoRPCCmd.RunE(command, nil); err != nil {
+		t.Fatal(err)
+	}
+	decoder := json.NewDecoder(&output)
+	for range 2 {
+		var result map[string]string
+		if err := decoder.Decode(&result); err != nil || result["error"] != "engine_invalid_request" {
+			t.Fatal(result, err)
+		}
+	}
+	command.SetIn(strings.NewReader(strings.Repeat("x", 65537) + "\n"))
+	if err := netgoRPCCmd.RunE(command, nil); err == nil {
+		t.Fatal("unbounded frame accepted")
+	}
+}
