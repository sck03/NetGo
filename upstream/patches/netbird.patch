+package cmd
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/netbirdio/netbird/client/proto"
+	"google.golang.org/grpc"
+	"testing"
+)
+
+type routeRPC struct {
+	proto.DaemonServiceClient
+	listed   int
+	selected *proto.SelectNetworksRequest
+}
+
+func (r *routeRPC) ListNetworks(context.Context, *proto.ListNetworksRequest, ...grpc.CallOption) (*proto.ListNetworksResponse, error) {
+	r.listed++
+	return &proto.ListNetworksResponse{Routes: []*proto.Network{{ID: "nas", Range: "192.168.1.0/24"}}}, nil
+}
+func (r *routeRPC) SelectNetworks(_ context.Context, request *proto.SelectNetworksRequest, _ ...grpc.CallOption) (*proto.SelectNetworksResponse, error) {
+	r.selected = request
+	return &proto.SelectNetworksResponse{}, nil
+}
+func TestNetGoRoutesEmptyAndDuplicateCIDRs(t *testing.T) {
+	for _, input := range []string{`{"resources":[]}`, `{"resources":[{"cidr":"192.168.1.0/24"},{"cidr":"192.168.1.0/24"}]}`} {
+		var request netgoRPCRequest
+		if err := json.Unmarshal([]byte(input), &request); err != nil {
+			t.Fatal(err)
+		}
+		rpc := &routeRPC{}
+		if _, err := netgoSelectRoutes(context.Background(), rpc, request); err != nil {
+			t.Fatal(err)
+		}
+		want := 0
+		if len(request.Resources) > 0 {
+			want = 1
+		}
+		if rpc.selected == nil || rpc.selected.Append || len(rpc.selected.NetworkIDs) != want || rpc.listed != want {
+			t.Fatalf("incorrect selection for %s: %+v lists=%d", input, rpc.selected, rpc.listed)
+		}
+	}
+}
diff --git a/client/cmd/netgo_rpc.go b/client/cmd/netgo_rpc.go
new file mode 100644
index 0000000..84ecd5b
--- /dev/null
+++ b/client/cmd/netgo_rpc.go
@@ -0,0 +1,276 @@
+package cmd
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/netbirdio/netbird/client/internal/profilemanager"
+	"github.com/netbirdio/netbird/client/proto"
+	"github.com/spf13/cobra"
+	"google.golang.org/grpc/metadata"
+)
+
+// This process adapter keeps daemon protobuf and caller authorization in NetBird.
+// Secrets travel on inherited stdin, never in command-line flags or log messages.
+var netgoRPCCmd = &cobra.Command{
+	Use: "netgo-rpc", Hidden: true, Args: cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		scanner := bufio.NewScanner(cmd.InOrStdin())
+		scanner.Buffer(make([]byte, 4096), 65537)
+		encoder := json.NewEncoder(cmd.OutOrStdout())
+		for scanner.Scan() {
+			var req netgoRPCRequest
+			decoder := json.NewDecoder(bytes.NewReader(scanner.Bytes()))
+			decoder.DisallowUnknownFields()
+			var tail any
+			if err := decoder.Decode(&req); err != nil || decoder.Decode(&tail) != io.EOF {
+				if err := encoder.Encode(map[string]string{"error": "engine_invalid_request"}); err != nil {
+					return err
+				}
+				continue
+			}
+			result, err := netgoRPC(cmd.Context(), req)
+			if err != nil {
+				result = map[string]string{"error": netgoRPCError(err)}
+			}
+			if err := encoder.Encode(result); err != nil {
+				return err
+			}
+		}
+		return scanner.Err()
+	},
+}
+
+func init() { rootCmd.AddCommand(netgoRPCCmd) }
+
+type netgoRPCProfile struct {
+	Protocol                                                                   int
+	ConfigRevision                                                             uint64
+	ID, Name, Origin, CA, GatewayPeerID, GatewayIP, LocalRelay, AuxiliaryRelay string
+	Candidates                                                                 []struct{ ID, Address, Kind string }
+	InternetDNS                                                                []string
+}
+type netgoRPCRequest struct {
+	Action    string          `json:"action"`
+	Profile   netgoRPCProfile `json:"profile"`
+	IDToken   string          `json:"id_token"`
+	Internet  bool            `json:"internet"`
+	Resources []struct {
+		CIDR               string `json:"cidr"`
+		ID, Name, Protocol string
+		Ports              []uint16
+		Enabled            bool
+	} `json:"resources"`
+}
+
+func netgoRPC(ctx context.Context, req netgoRPCRequest) (any, error) {
+	ctx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	conn, err := DialClientGRPCServer(ctx, daemonAddr)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	client := proto.NewDaemonServiceClient(conn)
+	user, err := profilemanager.InvokingUser()
+	if err != nil {
+		return nil, err
+	}
+	if req.Action == "down" {
+		_, err = client.Down(ctx, &proto.DownRequest{})
+		return map[string]bool{"done": err == nil}, err
+	}
+	p := req.Profile
+	if p.Protocol != 2 || !regexp.MustCompile("^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$").MatchString(p.ID) {
+		return nil, errors.New("invalid profile")
+	}
+	authority, err := url.Parse(p.Origin)
+	if err != nil || authority.Scheme != "https" || authority.Host == "" || authority.User != nil {
+		return nil, errors.New("invalid origin")
+	}
+	name := "netgo-" + p.ID
+	login := func(mode string) (*proto.LoginResponse, error) {
+		md := metadata.Pairs("netgo-mode", mode, "netgo-gateway-ip", p.GatewayIP, "netgo-local-relay", p.LocalRelay)
+		for _, c := range p.Candidates {
+			md.Append("netgo-candidate", c.Address)
+			md.Append("netgo-candidate-kind", c.Kind)
+		}
+		if p.CA != "" {
+			md.Append("netgo-ca-bin", p.CA)
+		}
+		if mode == "native" {
+			md.Append("netgo-jwt", req.IDToken)
+		}
+		yes, no := true, false
+		disableDNS := !req.Internet
+		return client.Login(metadata.NewOutgoingContext(ctx, md), &proto.LoginRequest{
+			ManagementUrl: p.Origin, ProfileName: &name, Username: &user.Username, DisableAutoConnect: &yes,
+			ServerSSHAllowed: &no, DisableServerRoutes: &yes, DisableIpv6: &yes, BlockInbound: &no, DisableDns: &disableDNS,
+		})
+	}
+	switch req.Action {
+	case "prepare":
+		if _, err = client.Down(ctx, &proto.DownRequest{}); err != nil {
+			return nil, err
+		}
+		profiles, err := client.ListProfiles(ctx, &proto.ListProfilesRequest{Username: user.Username})
+		if err != nil {
+			return nil, err
+		}
+		found := false
+		for _, profile := range profiles.Profiles {
+			if profile.Name == name {
+				if found {
+					return nil, errors.New("ambiguous profile")
+				}
+				found = true
+			}
+		}
+		if !found {
+			if _, err = client.AddProfile(ctx, &proto.AddProfileRequest{Username: user.Username, ProfileName: name}); err != nil {
+				return nil, err
+			}
+		}
+		response, err := login("prepare")
+		if err != nil {
+			return nil, err
+		}
+		if response.UserCode == "" || response.NeedsSSOLogin {
+			return nil, errors.New("native patch required")
+		}
+		return map[string]string{"wireguard_key": response.UserCode}, nil
+	case "login":
+		if req.IDToken == "" {
+			return nil, errors.New("token required")
+		}
+		_, err = login("native")
+		return map[string]bool{"done": err == nil}, err
+	case "up":
+		_, err = client.Up(ctx, &proto.UpRequest{ProfileName: &name, Username: &user.Username, Async: true})
+		return map[string]bool{"done": err == nil}, err
+	case "remove":
+		profiles, err := client.ListProfiles(ctx, &proto.ListProfilesRequest{Username: user.Username})
+		if err != nil {
+			return nil, err
+		}
+		found := false
+		for _, profile := range profiles.Profiles {
+			if profile.Name == name {
+				found = true
+				if profile.IsActive {
+					// Down leaves the profile selected. The dedicated service's
+					// offline default must be selected before deleting its keys.
+					state, err := client.Status(ctx, &proto.StatusRequest{})
+					if err != nil {
+						return nil, err
+					}
+					if state.Status != "Idle" && state.Status != "NeedsLogin" {
+						return nil, errors.New("disconnect before removal")
+					}
+					park := "default"
+					if _, err = client.SwitchProfile(ctx, &proto.SwitchProfileRequest{ProfileName: &park, Username: &user.Username}); err != nil {
+						return nil, err
+					}
+				}
+				break
+			}
+		}
+		if !found {
+			return map[string]bool{"done": true}, nil
+		}
+		_, err = client.RemoveProfile(ctx, &proto.RemoveProfileRequest{Username: user.Username, ProfileName: name})
+		return map[string]bool{"done": err == nil}, err
+	case "status":
+		v, err := client.Status(ctx, &proto.StatusRequest{GetFullPeerStatus: true})
+		if err != nil {
+			return nil, err
+		}
+		out := map[string]any{"state": v.Status, "path": "negotiating", "ip": "", "relay": "", "rx": int64(0), "tx": int64(0)}
+		if v.FullStatus != nil {
+			if v.FullStatus.LocalPeerState != nil {
+				out["ip"] = v.FullStatus.LocalPeerState.IP
+			}
+			for _, peer := range v.FullStatus.Peers {
+				if strings.Split(peer.IP, "/")[0] != p.GatewayIP {
+					continue
+				}
+				out["rx"], out["tx"] = peer.BytesRx, peer.BytesTx
+				if !strings.EqualFold(peer.ConnStatus, "connected") {
+					continue
+				}
+				out["path"] = "direct"
+				if peer.Relayed {
+					out["relay"], out["path"] = peer.RelayAddress, "relay_unknown"
+					if netgoRelayMatches(peer.RelayAddress, p.LocalRelay) {
+						out["path"] = "local_relay"
+					} else if netgoRelayMatches(peer.RelayAddress, p.AuxiliaryRelay) {
+						out["path"] = "auxiliary_relay"
+					}
+				}
+				break
+			}
+		}
+		return out, nil
+	case "routes":
+		return netgoSelectRoutes(ctx, client, req)
+	default:
+		return nil, errors.New("unsupported action")
+	}
+}
+
+func netgoSelectRoutes(ctx context.Context, client proto.DaemonServiceClient, req netgoRPCRequest) (any, error) {
+	wanted := make(map[string]bool, len(req.Resources))
+	for _, resource := range req.Resources {
+		wanted[resource.CIDR] = true
+	}
+	var ids []string
+	deadline := time.Now().Add(15 * time.Second)
+	for len(wanted) != 0 {
+		networks, err := client.ListNetworks(ctx, &proto.ListNetworksRequest{})
+		if err != nil {
+			return nil, err
+		}
+		ids = nil
+		seen := make(map[string]bool, len(wanted))
+		for _, network := range networks.Routes {
+			if wanted[network.Range] && !seen[network.Range] {
+				ids = append(ids, network.ID)
+				seen[network.Range] = true
+			}
+		}
+		if len(seen) == len(wanted) {
+			break
+		}
+		if time.Now().After(deadline) {
+			return nil, errors.New("authorized route unavailable")
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(200 * time.Millisecond):
+		}
+	}
+	_, err := client.SelectNetworks(ctx, &proto.SelectNetworksRequest{NetworkIDs: ids, Append: false})
+	return map[string]bool{"done": err == nil}, err
+}
+
+func netgoRPCError(err error) string {
+	if errors.Is(err, context.Canceled) {
+		return "cancelled"
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "engine_timeout"
+	}
+	if err.Error() == "authorized route unavailable" {
+		return "authorized_route_unavailable"
+	}
+	return "engine_rpc_failed"
+}
diff --git a/client/cmd/netgo_rpc_stream_test.go b/client/cmd/netgo_rpc_stream_test.go
