+package grpc
+import("testing")
+func TestNetGoCandidateValidation(t *testing.T){if e:=ConfigureNetGoRoutes("site.test:443",[]string{"site.test:443","vps.test:8443"});e!=nil{t.Fatal(e)};if _,ok:=netgoDialOption("site.test:443");!ok{t.Fatal("not registered")};if _,ok:=netgoDialOption("another.test:443");ok{t.Fatal("cross-site route leak")};for _,s:=range []string{"no-port","https://site.test:443","bad\n:443"}{if ConfigureNetGoRoutes("site.test:443",[]string{s})==nil{t.Fatal("unsafe candidate",s)}}}
