+// NetGo's independently owned lease gate must run before any broad interface
+// accept. Treating it as a host firewall to open bypasses session revocation
+// and kernel expiry. NetGo separately verifies ownership of this reserved table.
+func isNetGoLeaseGate(chain *nftables.Chain) bool {
+	return chain.Table.Family == nftables.TableFamilyINet && chain.Table.Name == "netgo"
+}
+
 func (r *family) isExternalChain(chain *nftables.Chain) bool {
+	if isNetGoLeaseGate(chain) {
+		return false
+	}
 	if r.workTable != nil && chain.Table.Name == r.workTable.Name {
 		return false
 	}
