@@ -0,0 +1,25 @@
+package nftables
+
+import (
+	"testing"
+
+	"github.com/google/nftables"
+)
+
+func TestNetGoLeaseGateNeverReceivesInterfaceAccept(t *testing.T) {
+	r := &family{}
+	for _, hook := range []*nftables.ChainHook{nftables.ChainHookInput, nftables.ChainHookForward} {
+		gate := &nftables.Chain{Table: &nftables.Table{Name: "netgo", Family: nftables.TableFamilyINet}, Type: nftables.ChainTypeFilter, Hooknum: hook}
+		if r.isExternalChain(gate) {
+			t.Fatal("lease gate selected for broad interface acceptance")
+		}
+		// There is deliberately no netlink connection: neither startup nor a
+		// later external-chain monitor update may inspect or modify the gate.
+		r.applyExternalChainAccept(gate, ifname("wt0"), true)
+		ordinary := *gate
+		ordinary.Table = &nftables.Table{Name: "host_policy", Family: nftables.TableFamilyINet}
+		if !r.isExternalChain(&ordinary) {
+			t.Fatal("unrelated host firewall integration was disabled")
+		}
+	}
+}
