diff --git a/client/grpc/netgo.go b/client/grpc/netgo.go
new file mode 100644
index 0000000..4d63cdf
--- /dev/null
+++ b/client/grpc/netgo.go
@@ -0,0 +1,106 @@
+package grpc
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+	"net"
+	"strings"
+	"sync"
+	"time"
+)
+
+var netgoRoutes = struct {
+	sync.RWMutex
+	m     map[string][]string
+	roots map[string]*x509.CertPool
+}{m: map[string][]string{}, roots: map[string]*x509.CertPool{}}
+
+// CA bytes are public trust material received only through an authorized Login.
+// Never accept a caller-supplied filesystem path opened by the privileged daemon.
+func ConfigureNetGoCA(authority, ca string) error {
+	if len(ca) > 256*1024 {
+		return errors.New("NetGo CA too large")
+	}
+	var roots *x509.CertPool
+	if ca != "" {
+		roots, _ = x509.SystemCertPool()
+		if roots == nil {
+			roots = x509.NewCertPool()
+		}
+		if !roots.AppendCertsFromPEM([]byte(ca)) {
+			return errors.New("invalid NetGo CA")
+		}
+	}
+	netgoRoutes.Lock()
+	defer netgoRoutes.Unlock()
+	if roots == nil {
+		delete(netgoRoutes.roots, authority)
+	} else {
+		netgoRoutes.roots[authority] = roots
+	}
+	return nil
+}
+func netgoTLSOption(authority string) (grpc.DialOption, bool) {
+	netgoRoutes.RLock()
+	roots, ok := netgoRoutes.roots[authority]
+	netgoRoutes.RUnlock()
+	if !ok {
+		return nil, false
+	}
+	host, _, err := net.SplitHostPort(authority)
+	if err != nil {
+		host = authority
+	}
+	return grpc.WithTransportCredentials(credentials.NewTLS(&tls.Config{ServerName: host, RootCAs: roots, MinVersion: tls.VersionTLS12})), true
+}
+
+// Called only after the daemon's profile/configuration ownership checks.
+func ConfigureNetGoRoutes(authority string, candidates []string) error {
+	if len(candidates) > 8 {
+		return errors.New("too many NetGo candidates")
+	}
+	for _, addr := range candidates {
+		h, p, e := net.SplitHostPort(addr)
+		if e != nil || h == "" || p == "" || strings.ContainsAny(addr, "\n\r/\\ ") {
+			return errors.New("invalid NetGo candidate")
+		}
+	}
+	netgoRoutes.Lock()
+	defer netgoRoutes.Unlock()
+	netgoRoutes.m[authority] = append([]string(nil), candidates...)
+	return nil
+}
+func netgoDialOption(authority string) (grpc.DialOption, bool) {
+	netgoRoutes.RLock()
+	_, ok := netgoRoutes.m[authority]
+	netgoRoutes.RUnlock()
+	if !ok {
+		return nil, false
+	}
+	return grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) {
+		netgoRoutes.RLock()
+		list := append([]string(nil), netgoRoutes.m[authority]...)
+		roots := netgoRoutes.roots[authority]
+		netgoRoutes.RUnlock()
+		host, _, e := net.SplitHostPort(authority)
+		if e != nil {
+			host = authority
+		}
+		for _, addr := range list {
+			probe, cancel := context.WithTimeout(ctx, 3*time.Second)
+			td := tls.Dialer{NetDialer: &net.Dialer{Timeout: 3 * time.Second}, Config: &tls.Config{ServerName: host, RootCAs: roots, MinVersion: tls.VersionTLS12, NextProtos: []string{"h2"}}}
+			c, e := td.DialContext(probe, "tcp", addr)
+			cancel()
+			if e != nil {
+				continue
+			}
+			c.Close()
+			return (&net.Dialer{Timeout: 3 * time.Second, KeepAlive: 30 * time.Second}).DialContext(ctx, "tcp", addr)
+		}
+		return nil, errors.New("no trusted NetGo control candidate")
+	}), true
+}
