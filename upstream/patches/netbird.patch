+package uspfilter
+
+import (
+	"encoding/binary"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestNetGoFragmentedOutboundUDPTracksOnlyItsReply(t *testing.T) {
+	m := newFragmentTestManager(t)
+	outgoing := outboundUDPPacket(t, 12345, 40000)
+	binary.BigEndian.PutUint16(outgoing[6:8], 0x2000)
+	require.False(t, m.filterOutbound(outgoing, len(outgoing)))
+	first := firstFragmentUDP(t, 0x9876, 12345, 32)
+	require.False(t, m.filterInbound(first, len(first)), "first reply fragment needs the outbound flow")
+	trailing := trailingFragment(t, 0x9876, 5, false, 24)
+	require.False(t, m.filterInbound(trailing, len(trailing)))
+	wrongPort := firstFragmentUDP(t, 0x9877, 12346, 32)
+	require.True(t, m.filterInbound(wrongPort, len(wrongPort)), "a different destination port must remain denied")
+	orphan := trailingFragment(t, 0x9878, 5, false, 24)
+	require.True(t, m.filterInbound(orphan, len(orphan)), "orphan fragment must remain denied")
+}
