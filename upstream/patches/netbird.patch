+		_, _, _ = conn.Read(r.Context())
+	}))
+	defer server.Close()
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	address := strings.Replace(server.URL, "https://", "rels://", 1)
+	dial := func(ctx context.Context, name string) error {
+		ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+		defer cancel()
+		conn, err := (Dialer{}).Dial(ctx, address, name)
+		if conn != nil {
+			_ = conn.Close()
+		}
+		return err
+	}
+	if err := dial(context.Background(), ""); err == nil {
+		t.Fatal("unknown private CA accepted")
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(server.Certificate())
+	ctx := relayTLS.WithNetGoRootCAs(context.Background(), pool)
+	if err := dial(ctx, ""); err != nil {
+		t.Fatal("explicit profile CA rejected", err)
+	}
+	if err := dial(ctx, "wrong.example.test"); err == nil {
+		t.Fatal("custom CA bypassed hostname verification")
+	}
+	if err := dial(relayTLS.WithNetGoRootCAs(ctx, nil), ""); err == nil {
+		t.Fatal("cleared profile kept its predecessor's CA")
+	}
+}
