+package grpc
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+
+	relayClient "github.com/netbirdio/netbird/shared/relay/client"
+)
+
+func TestNetGoRelayRoleIsBoundToRegisteredAuthority(t *testing.T) {
+	t.Setenv("NB_NETGO_ROUTING_PEER", "false")
+	authority := "relay-role.test:10443"
+	if err := ConfigureNetGoRoutes(authority, []string{"192.0.2.1:10443"}, "direct"); err != nil {
+		t.Fatal(err)
+	}
+	if err := ConfigureNetGoTopology(authority, "100.96.0.1", "192.0.2.1"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		netgoRoutes.Lock()
+		delete(netgoRoutes.m, authority)
+		delete(netgoRoutes.topology, authority)
+		netgoRoutes.Unlock()
+	})
+	urls := []string{"rels://192.0.2.1:18443", "rels://198.51.100.1:28443"}
+	selected := relayClient.NewManager(NetGoRelayContext(context.Background(), authority), urls, "client", 1280)
+	parent := NetGoRelayContext(context.Background(), authority)
+	other := relayClient.NewManager(NetGoRelayContext(parent, "other.test:10443"), urls, "other", 1280)
+	if !selected.NetGoRelaySelection() || other.NetGoRelaySelection() {
+		t.Fatal("NetGo relay mode crossed authority boundary")
+	}
+	chosen, err := selected.PreferredRelay(urls[1], urls[0], false, netip.MustParseAddr("100.96.0.1"))
+	if err != nil || chosen != urls[1] {
+		t.Fatalf("profile topology not propagated: %s %v", chosen, err)
+	}
+}
+
+func TestNetGoTopologyRejectsInvalidConfiguration(t *testing.T) {
+	for _, topology := range [][2]string{{"not-ip", "relay.test"}, {"::1", "relay.test"}, {"100.96.0.1", "https://relay.test"}, {"100.96.0.1", "relay.test/collect"}, {"100.96.0.1", "user@relay.test"}} {
+		if ConfigureNetGoTopology("invalid.test", topology[0], topology[1]) == nil {
+			t.Fatalf("invalid topology accepted: %v", topology)
+		}
+	}
+	if ConfigureNetGoRoutes("invalid.test", []string{"relay.test:443"}) == nil {
+		t.Fatal("missing candidate kind accepted")
+	}
+}
