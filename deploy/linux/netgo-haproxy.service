# Managed by NetGo v1
[Unit]
Description=NetGo optional TCP 443 SNI gateway
After=network-online.target netgo-caddy.service netbird-relay.service
[Service]
User=netgo
Group=netgo
ExecStartPre=/usr/sbin/haproxy -c -f /etc/netgo/haproxy.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /etc/netgo/haproxy.cfg -p /run/netgo-haproxy/haproxy.pid
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=3
RuntimeDirectory=netgo-haproxy
RuntimeDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
