# Managed by NetGo v1
[Unit]
Description=NetGo dedicated Linux routing peer
After=network-online.target netbird-server.service
[Service]
User=root
StateDirectory=netgo-router
StateDirectoryMode=0700
RuntimeDirectory=netgo-router
RuntimeDirectoryMode=0755
ExecStart=/opt/netgo/upstream/netbird --config /var/lib/netgo-router/config.json --daemon-addr unix:///run/netgo-router/netbird.sock service run
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
