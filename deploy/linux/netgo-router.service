# Managed by NetGo v1
[Unit]
Description=NetGo dedicated Linux routing peer
After=network-online.target netbird-server.service
[Service]
User=root
StateDirectory=netgo-router
StateDirectoryMode=0700
RuntimeDirectory=netgo-router
RuntimeDirectoryMode=0755
Environment=SSL_CERT_FILE=/etc/netgo/tls/trust.pem
Environment=NB_STATE_DIR=/var/lib/netgo-router
Environment=NB_LAZY_CONN=false
Environment=NB_NETGO_ROUTING_PEER=true
ExecStart=/opt/netgo/upstream/netbird --log-file console --config /var/lib/netgo-router/config.json --daemon-addr unix:///run/netgo-router/netbird.sock service run
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
