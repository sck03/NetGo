# Managed by NetGo v1
[Unit]
Description=NetGo TLS control gateway
After=network-online.target netbird-server.service netgo-server.service
[Service]
User=netgo
Group=netgo
ExecStart=/opt/netgo/upstream/caddy run --config /etc/netgo/Caddyfile --adapter caddyfile
ExecReload=/opt/netgo/upstream/caddy reload --config /etc/netgo/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
StateDirectory=netgo-caddy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/netgo-caddy
Environment=XDG_CONFIG_HOME=/var/lib/netgo-caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
