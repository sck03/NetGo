NB_LISTEN_ADDRESS=:@@AUX_RELAY_BIND_PORT@@
NB_EXPOSED_ADDRESS=rels://@@AUX_RELAY_HOST@@:@@AUX_RELAY_PORT@@
NB_AUTH_SECRET=@@RELAY_SECRET@@
NB_ENABLE_STUN=true
NB_STUN_PORTS=@@AUX_STUN_PORT@@
NB_METRICS_PORT=9091
NB_METRICS_LISTEN_ADDRESS=127.0.0.1:9091
NB_HEALTH_LISTEN_ADDRESS=127.0.0.1:9001
NB_TLS_CERT_FILE=/etc/netgo/tls/relay.crt
NB_TLS_KEY_FILE=/etc/netgo/tls/relay.key
NB_LOG_LEVEL=info
