server:
  listenAddress: "@@MANAGEMENT_LISTEN@@"
  exposedAddress: "@@CONTROL_ORIGIN@@"
  healthcheckAddress: "127.0.0.1:9000"
  metricsPort: 9090
  logLevel: "info"
  logFile: "console"
  dataDir: "/var/lib/netbird-server"
  disableAnonymousMetrics: true
  disableGeoliteUpdate: true
  stuns:
    - uri: "stun:@@LOCAL_RELAY@@:@@STUN_PORT@@"
@@AUX_STUN@@
  relays:
    addresses:
      - "rels://@@LOCAL_RELAY@@:@@PUBLIC_RELAY_PORT@@"
@@AUX_RELAY@@
    credentialsTTL: "12h"
    secret: "@@RELAY_SECRET@@"
  auth:
    issuer: "@@CONTROL_ORIGIN@@/oauth2"
    localAuthDisabled: false
    signKeyRefreshEnabled: true
    cliRedirectURIs:
      - "http://localhost:53000/"
    dashboardRedirectURIs:
      - "@@CONTROL_ORIGIN@@/nb-auth"
  store:
    engine: "sqlite"
    encryptionKey: "@@STORE_KEY@@"
