global
 maxconn 4096
 user haproxy
 group haproxy
 log stdout format raw local0
defaults
 mode tcp
 timeout connect 5s
 timeout client 1h
 timeout server 1h
frontend netgo_tls
 bind :443
 tcp-request inspect-delay 5s
 tcp-request content accept if { req.ssl_hello_type 1 }
 use_backend control if { req.ssl_sni -i @@CONTROL_HOST@@ }
 use_backend relay if { req.ssl_sni -i @@LOCAL_RELAY@@ }
 default_backend reject_unknown
backend control
 server local 127.0.0.1:9443
backend relay
 server local 127.0.0.1:8443
backend reject_unknown
 tcp-request content reject
