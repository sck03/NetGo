{
 admin 127.0.0.1:@@CADDY_ADMIN_PORT@@
 auto_https off
 default_sni @@CONTROL_HOST@@
 servers {
  protocols h1 h2
 }
}
https://@@CONTROL_HOST@@:@@CONTROL_PORT@@ {
@@CONTROL_BIND_DIRECTIVE@@
 tls /etc/netgo/tls/control.crt /etc/netgo/tls/control.key
 @private path /oauth2/netgo/* /api/setup
 handle @private {
  respond 404
 }
 @netgo path /netgo/* /assets/* /
 handle @netgo {
  reverse_proxy @@PRODUCT_LISTEN@@
 }
 handle {
  reverse_proxy h2c://@@MANAGEMENT_LISTEN@@
 }
}
