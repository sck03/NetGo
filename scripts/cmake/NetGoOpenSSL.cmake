# MinGW's FindOpenSSL uses LIB_EAY/SSL_EAY internally. Setting only
# OPENSSL_*_LIBRARY can silently combine our headers with MSYS libraries.
if(MINGW)
  get_filename_component(_netgo_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
  set(NETGO_OPENSSL_ROOT "${_netgo_root}/.tools/openssl-native" CACHE PATH "Pinned NetGo OpenSSL installation")
  file(READ "${_netgo_root}/upstream/versions.lock.json" _netgo_inputs)
  string(JSON _netgo_openssl_version GET "${_netgo_inputs}" openssl version)
  set(OPENSSL_USE_STATIC_LIBS TRUE)
  set(OPENSSL_ROOT_DIR "${NETGO_OPENSSL_ROOT}")
  set(OPENSSL_INCLUDE_DIR "${NETGO_OPENSSL_ROOT}/include" CACHE PATH "Pinned OpenSSL headers" FORCE)
  foreach(_component IN LISTS NETGO_OPENSSL_COMPONENTS)
    if(_component STREQUAL "Crypto")
      set(_archive "${NETGO_OPENSSL_ROOT}/lib64/libcrypto.a")
      set(LIB_EAY "${_archive}" CACHE FILEPATH "Pinned OpenSSL Crypto" FORCE)
      set(OPENSSL_CRYPTO_LIBRARY "${_archive}" CACHE FILEPATH "Pinned OpenSSL Crypto" FORCE)
    elseif(_component STREQUAL "SSL")
      set(_archive "${NETGO_OPENSSL_ROOT}/lib64/libssl.a")
      set(SSL_EAY "${_archive}" CACHE FILEPATH "Pinned OpenSSL SSL" FORCE)
      set(OPENSSL_SSL_LIBRARY "${_archive}" CACHE FILEPATH "Pinned OpenSSL SSL" FORCE)
    else()
      message(FATAL_ERROR "Unsupported OpenSSL component: ${_component}")
    endif()
    if(NOT EXISTS "${_archive}")
      message(FATAL_ERROR "Pinned OpenSSL archive missing: ${_archive}; run prepare-native.ps1")
    endif()
  endforeach()
  find_package(OpenSSL ${_netgo_openssl_version} EXACT REQUIRED COMPONENTS ${NETGO_OPENSSL_COMPONENTS})
  # The pinned OpenSSL uses Windows CNG for its system entropy source.
  set_property(TARGET OpenSSL::Crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES bcrypt)
else()
  find_package(OpenSSL REQUIRED COMPONENTS ${NETGO_OPENSSL_COMPONENTS})
endif()
