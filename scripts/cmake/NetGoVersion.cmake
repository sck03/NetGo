if(NOT DEFINED NETGO_VERSION OR NETGO_VERSION STREQUAL "")
  if(DEFINED ENV{NETGO_VERSION} AND NOT "$ENV{NETGO_VERSION}" STREQUAL "")
    set(NETGO_VERSION "$ENV{NETGO_VERSION}")
  else()
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../../VERSION" NETGO_VERSION)
    string(STRIP "${NETGO_VERSION}" NETGO_VERSION)
  endif()
endif()
if(NOT NETGO_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.+-]+)?$")
  message(FATAL_ERROR "Invalid NetGo version")
endif()
string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" NETGO_VERSION_CORE "${NETGO_VERSION}")
string(REPLACE "." "," NETGO_VERSION_RC "${NETGO_VERSION_CORE}")
set(NETGO_VERSION_RC "${NETGO_VERSION_RC},0")
set(NETGO_VERSION_RESOURCE "${CMAKE_CURRENT_BINARY_DIR}/netgo-version.rc")
configure_file("${CMAKE_CURRENT_LIST_DIR}/netgo-version.rc.in" "${NETGO_VERSION_RESOURCE}" @ONLY)
add_compile_definitions(NETGO_BUILD_VERSION="${NETGO_VERSION}")
message(STATUS "NetGo project version: ${NETGO_VERSION}")
